# Copy to .dev.vars for local use. Set production secrets in the server environment.
# Official carrier APIs require accounts and their own eligibility rules.
# Preferred open-source scraper service (public HTTPS URL + its own server token).
SCRAPER_BASE_URL=
SCRAPER_TOKEN=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
DHL_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Self-hosted Karrio URL and its API token. Carrier accounts must be connected in Karrio.
KARRIO_BASE_URL=
KARRIO_API_KEY=
